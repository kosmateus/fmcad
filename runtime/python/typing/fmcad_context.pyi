"""Narrow declarations for real injected values, not an open-ended API shim.

Unsupported facade producers/members remain visible to the checker.
"""
from typing import Callable, Iterable, TypeAlias
import adsk.core
import adsk.fusion

JsonValue: TypeAlias = None | bool | int | float | str | list["JsonValue"] | dict[str, "JsonValue"]

class Facade:
    doc: adsk.core.Document
    design: adsk.fusion.Design
    root: adsk.fusion.Component
    def stage(self) -> dict[str, JsonValue]: ...
    def journalInspect(self) -> dict[str, JsonValue]: ...
    def resumePlan(self) -> dict[str, JsonValue]: ...
    def call(self, operation: str, data: dict[str, JsonValue], component: str | None = None) -> JsonValue: ...
    def resolve(self, ref: str | dict[str, JsonValue], expected_kind: str | None = None) -> object: ...
    def length(self, expression: str) -> float: ...
    def angle(self, expression: str) -> float: ...
    def point(self, coordinates: list[str] | tuple[str, str, str]) -> adsk.core.Point3D | None: ...
    def value(self, expression: str) -> adsk.core.ValueInput: ...
    def collection(self, entities: Iterable[adsk.core.Base]) -> adsk.core.ObjectCollection: ...
    def parameter_test(self, spec: dict[str, JsonValue], check_case: Callable[..., object], check_restored: Callable[..., object]) -> object: ...
    def temporary_body(self, ref: str | dict[str, JsonValue], frame: dict[str, JsonValue]) -> object: ...
    def compare_bodies(self, a: str | dict[str, JsonValue], b: str | dict[str, JsonValue], frame: dict[str, JsonValue], volume_tolerance: float, linear_tolerance: float, angular_tolerance: float) -> object: ...
    def require_pass(self, result: dict[str, JsonValue]) -> dict[str, JsonValue]: ...
    def require_history_end(self) -> None: ...
    # Authenticated worker stage views are JSON evidence, not authority to
    # resume, replay, or submit. The owner adapter performs those checks.
    def stage(self) -> JsonValue: ...
    def journalInspect(self) -> JsonValue: ...
    def resumePlan(self) -> JsonValue: ...
    def emit(self, payload: JsonValue) -> None: ...
