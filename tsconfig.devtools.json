{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "scripts/devtools",
    "outDir": "dist/scripts/devtools",
    "types": ["node"],
    "noPropertyAccessFromIndexSignature": false,
    "noEmitOnError": true,
    "incremental": false
  },
  "include": ["scripts/devtools/**/*.ts"],
  "references": [
    {
      "path": "./packages/node-adapters"
    },
    {
      "path": "./packages/control-center"
    }
  ]
}
