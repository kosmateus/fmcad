    {"id": "diameter", "operation": "sketch.dimension", "component": {"$ref": "part.result.component"}, "onExisting": "reuse", "data": {"sketch": {"$ref": "section.result.sketch"}, "type": "diameter", "entities": [{"$ref": "rim.result.refs.rim"}], "text": ["25 mm", "25 mm", "0 mm"], "expression": {"$param": "diameter"}}},
