{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": true,
    "verbatimModuleSyntax": true,
    "rootDir": "src",
    "outDir": "dist/browser"
  },
  "include": ["src/contracts/query.ts", "src/web/**/*.ts"]
}
