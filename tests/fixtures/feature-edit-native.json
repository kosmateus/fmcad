{
  "runId": "feature-edit-native-families-v5",
  "atomic": false,
  "operations": [
    {"id":"base", "operation":"shape.box", "data":{"name":"FE_Base","width":"40 mm","depth":"40 mm","height":"10 mm"}},
    {"id":"editExtrudePreview", "operation":"feature.edit", "data":{"schemaVersion":1,"frame":"component","feature":{"$ref":"base.result.feature"},"nativeEdits":{"profile":{"kind":"profile","sketch":{"$ref":"base.result.helpers.0"},"index":0}},"preview":true}},
    {"id":"editExtrude", "operation":"feature.edit", "data":{"schemaVersion":1,"frame":"component","feature":{"$ref":"base.result.feature"},"nativeEdits":{"profile":{"kind":"profile","sketch":{"$ref":"base.result.helpers.0"},"index":0}},"confirm":true}},
    {"id":"edgeForFillet", "operation":"entity.find", "data":{"kind":"edge","scope":{"feature":{"$ref":"base.result.feature"}},"filters":{"length":"10 mm","axis":[0,0,1],"position":["0 mm","0 mm","0 mm"],"tolerance":"0.01 mm"},"expect":1}},
    {"id":"revolveSketch", "operation":"sketch.create", "data":{"name":"FE_RevolveSection","plane":"XY"}},
    {"id":"revolveGeometry", "operation":"sketch.geometry", "data":{"sketch":{"$ref":"revolveSketch.result.sketch"},"geometry":[{"type":"rectangle","start":["5 mm","0 mm","0 mm"],"end":["12 mm","8 mm","0 mm"]}]}},
    {"id":"revolve", "operation":"model.revolve", "data":{"name":"FE_Revolve","profile":{"kind":"profile","sketch":{"$ref":"revolveSketch.result.sketch"},"index":0},"axis":"Y","angle":"120 deg","operation":"newBody"}},
    {"id":"editRevolve", "operation":"feature.edit", "data":{"schemaVersion":1,"frame":"component","feature":{"$ref":"revolve.result.feature"},"nativeEdits":{"profile":{"kind":"profile","sketch":{"$ref":"revolveSketch.result.sketch"},"index":0},"axis":"Y"},"confirm":true}},
    {"id":"fillet", "operation":"model.fillet", "data":{"name":"FE_Fillet","edges":[{"$ref":"edgeForFillet.result.refs.0"}],"radius":"1 mm","tangentChain":false}},
    {"id":"editFillet", "operation":"feature.edit", "data":{"schemaVersion":1,"frame":"component","feature":{"$ref":"fillet.result.feature"},"nativeEdits":{"edgeSets":[{"index":0,"radius":"1.5 mm"}]},"confirm":true}},
    {"id":"chamferSeed", "operation":"shape.box", "data":{"name":"FE_ChamferSeed","width":"30 mm","depth":"30 mm","height":"12 mm"}},
    {"id":"edgeForChamfer", "operation":"entity.find", "data":{"kind":"edge","scope":{"feature":{"$ref":"chamferSeed.result.feature"}},"filters":{"length":"12 mm","axis":[0,0,1],"position":["0 mm","0 mm","0 mm"],"tolerance":"0.01 mm"},"expect":1}},
    {"id":"chamfer", "operation":"model.chamfer", "data":{"name":"FE_Chamfer","edges":[{"$ref":"edgeForChamfer.result.refs.0"}],"distance":"0.5 mm","tangentChain":false}},
    {"id":"editChamfer", "operation":"feature.edit", "data":{"schemaVersion":1,"frame":"component","feature":{"$ref":"chamfer.result.feature"},"nativeEdits":{"edgeSets":[{"index":0,"distance":"0.75 mm"}]},"confirm":true}},
    {"id":"holeSeed", "operation":"shape.box", "data":{"name":"FE_HoleSeed","width":"30 mm","depth":"30 mm","height":"12 mm"}},
    {"id":"holeSketch", "operation":"sketch.create", "data":{"name":"FE_HolePoints","plane":"XY"}},
    {"id":"holePoint", "operation":"sketch.geometry", "data":{"sketch":{"$ref":"holeSketch.result.sketch"},"geometry":[{"type":"point","name":"Center","point":["20 mm","20 mm","0 mm"]}]}},
    {"id":"hole", "operation":"model.hole", "data":{"name":"FE_Hole","points":[{"$ref":"holePoint.result.refs.Center"}],"diameter":"3 mm","depth":"6 mm","reverse":true,"participants":[{"$ref":"holeSeed.result.bodies.0"}]}},
    {"id":"editHole", "operation":"feature.edit", "data":{"schemaVersion":1,"frame":"component","feature":{"$ref":"hole.result.feature"},"nativeEdits":{"holeType":{"type":"simple"},"position":{"mode":"sketchPoints","points":[{"$ref":"holePoint.result.refs.Center"}] }},"confirm":true}},
    {"id":"pattern", "operation":"pattern.circular", "data":{"name":"FE_Pattern","entities":[{"$ref":"revolve.result.feature"}],"axis":"Z","quantity":2,"angle":"180 deg"}},
    {"id":"editPattern", "operation":"feature.edit", "data":{"schemaVersion":1,"frame":"component","feature":{"$ref":"pattern.result.feature"},"nativeEdits":{"entities":[{"$ref":"revolve.result.feature"}],"axis":"Z","isSymmetric":false},"confirm":true}},
    {"id":"mirror", "operation":"model.mirror", "data":{"name":"FE_Mirror","entities":[{"$ref":"revolve.result.feature"}],"plane":"YZ"}},
    {"id":"editMirror", "operation":"feature.edit", "data":{"schemaVersion":1,"frame":"component","feature":{"$ref":"mirror.result.feature"},"nativeEdits":{"entities":[{"$ref":"revolve.result.feature"}],"mirrorPlane":"YZ"},"confirm":true}},
    {"id":"shellSeed", "operation":"shape.box", "data":{"name":"FE_ShellSeed","width":"20 mm","depth":"20 mm","height":"15 mm"}},
    {"id":"shell", "operation":"model.shell", "data":{"name":"FE_Shell","entities":[{"$ref":"shellSeed.result.bodies.0"}],"thickness":"1 mm"}},
    {"id":"editShell", "operation":"feature.edit", "data":{"schemaVersion":1,"frame":"component","feature":{"$ref":"shell.result.feature"},"nativeEdits":{"entities":[{"$ref":"shellSeed.result.bodies.0"}],"insideThickness":"1 mm","isTangentChain":true},"confirm":true}},
    {"id":"sweepProfile", "operation":"sketch.create", "data":{"name":"FE_SweepProfile","plane":"XY"}},
    {"id":"sweepSection", "operation":"sketch.geometry", "data":{"sketch":{"$ref":"sweepProfile.result.sketch"},"geometry":[{"type":"circle","name":"Profile","center":["0 mm","0 mm","0 mm"],"radius":"2 mm"}]}},
    {"id":"sweepPathSketch", "operation":"sketch.create", "data":{"name":"FE_SweepPathSketch","plane":"XZ"}},
    {"id":"sweepPathGeometry", "operation":"sketch.geometry", "data":{"sketch":{"$ref":"sweepPathSketch.result.sketch"},"geometry":[{"type":"line","name":"PathLine","start":["0 mm","0 mm","0 mm"],"end":["0 mm","20 mm","0 mm"]}]}},
    {"id":"sweep", "operation":"model.sweep", "data":{"name":"FE_Sweep","profile":{"kind":"profile","sketch":{"$ref":"sweepProfile.result.sketch"},"index":0},"path":{"curves":[{"$ref":"sweepPathGeometry.result.refs.PathLine"}],"chain":"none"},"twist":"0 deg"}},
    {"id":"editSweep", "operation":"feature.edit", "data":{"schemaVersion":1,"frame":"component","feature":{"$ref":"sweep.result.feature"},"nativeEdits":{"profile":{"kind":"profile","sketch":{"$ref":"sweepProfile.result.sketch"},"index":0},"path":{"curves":[{"$ref":"sweepPathGeometry.result.refs.PathLine"}],"chain":"none"},"orientation":"perpendicular"},"confirm":true}},
    {"id":"loft", "operation":"shape.cone", "data":{"name":"FE_LoftSeed","baseRadius":"5 mm","topRadius":"3 mm","height":"20 mm"}},
    {"id":"loftRailSketch", "operation":"sketch.create", "data":{"name":"FE_LoftRailSketch","plane":"XZ"}},
    {"id":"loftRail", "operation":"sketch.geometry", "data":{"sketch":{"$ref":"loftRailSketch.result.sketch"},"geometry":[{"type":"line","name":"RailLine","start":["5 mm","0 mm","0 mm"],"end":["3 mm","-20 mm","0 mm"]}]}},
    {"id":"loftGuided", "operation":"model.loft", "data":{"name":"FE_LoftGuided","profiles":[{"kind":"profile","sketch":{"$ref":"loft.result.helpers.0"},"index":0},{"kind":"profile","sketch":{"$ref":"loft.result.helpers.2"},"index":0}],"rails":[{"curves":[{"$ref":"loftRail.result.refs.RailLine"}],"chain":"none"}]}},
    {"id":"editLoft", "operation":"feature.edit", "data":{"schemaVersion":1,"frame":"component","feature":{"$ref":"loftGuided.result.feature"},"nativeEdits":{"sections":[{"kind":"profile","sketch":{"$ref":"loft.result.helpers.0"},"index":0},{"kind":"profile","sketch":{"$ref":"loft.result.helpers.2"},"index":0}],"rails":[{"curves":[{"$ref":"loftRail.result.refs.RailLine"}],"chain":"none"}],"isClosed":false,"isTangentEdgesMerged":true},"confirm":true}},
    {"id":"thickenSection", "operation":"sketch.create", "data":{"name":"FE_ThickenSection","plane":"XY"}},
    {"id":"thickenGeometry", "operation":"sketch.geometry", "data":{"sketch":{"$ref":"thickenSection.result.sketch"},"geometry":[{"type":"rectangle","start":["0 mm","0 mm","0 mm"],"end":["10 mm","10 mm","0 mm"]}]}},
    {"id":"surfaceExtrude", "operation":"model.extrude", "data":{"name":"FE_SurfaceSeed","profile":{"kind":"profile","sketch":{"$ref":"thickenSection.result.sketch"},"index":0},"distance":"2 mm","solid":false}},
    {"id":"thicken", "operation":"model.thicken", "data":{"name":"FE_Thicken","entities":[{"$ref":"surfaceExtrude.result.bodies.0"}],"thickness":"1 mm"}},
    {"id":"editThicken", "operation":"feature.edit", "data":{"schemaVersion":1,"frame":"component","feature":{"$ref":"thicken.result.feature"},"nativeEdits":{"entities":[{"$ref":"surfaceExtrude.result.bodies.0"}],"isSymmetric":false,"thickenType":"sharp"},"confirm":true}}
  ]
}
